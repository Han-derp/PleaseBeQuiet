{
  "version": "3.5",
  "source": "请勿喧哗_完整版剧情对白与演出脚本 v3.5",
  "sceneOrder": ["CONSENT", "CALIBRATE", "WARD", "SEA", "RETURN_WARD", "MIRROR", "FINAL_DOOR", "AQUARIUM", "END"],
  "lines": [
    {"id":"W01","scene":"WARD","sequence":1,"channel":"哥·便签","status":"保留","text":"今天也要照顾好她。","trigger":"首次进入病房，停留约 1.5 秒后淡出","required":true},
    {"id":"H01","scene":"WARD","sequence":2,"channel":"妹·动作释义","status":"新增","text":"你来了。","trigger":"小满先抬手示意","required":true},
    {"id":"W02","scene":"WARD","sequence":3,"channel":"屏","status":"保留","text":"试着用手回应小满。","trigger":"教学开始，显示张掌示例与实时轮廓反馈","required":true},
    {"id":"H02","scene":"WARD","sequence":4,"channel":"妹·动作释义","status":"新增","text":"我看见啦。","trigger":"识别 PALM 成功后","required":true},
    {"id":"H03","scene":"WARD","sequence":5,"channel":"哥·动作旁白","status":"新增","text":"我想说……","trigger":"固定两秒的窗户倒影无声演出","required":true},
    {"id":"H04","scene":"WARD","sequence":6,"channel":"妹·动作释义","status":"新增","text":"不急。","trigger":"H03 后等待一拍，小满主动示意","required":true},
    {"id":"W03","scene":"WARD","sequence":7,"channel":"妹·动作释义","status":"保留","text":"等出院后，我们去看鱼。","trigger":"小满主动拿出水族馆票并转场深海","required":true},
    {"id":"S01","scene":"SEA","sequence":1,"channel":"屏·目标","status":"新增","text":"那条鱼，好像在看你。","trigger":"进入深海，小橙鱼出现","required":true},
    {"id":"S02","scene":"SEA","sequence":2,"channel":"境·弱提示","status":"新增·可延时","text":"水流……太急了。","trigger":"多次挥手且约 12 秒无进展；T8 无提示盲测关闭","required":false},
    {"id":"SEA01","scene":"SEA","sequence":3,"channel":"场景文字","status":"保留","text":"请勿喧哗。","trigger":"鱼群首次因玩家真实静止聚拢后，不跳场景","required":true},
    {"id":"S03","scene":"SEA","sequence":4,"channel":"屏·轻提示","status":"新增","text":"它还在等你。","trigger":"首次聚拢后保留可操作时段","required":true},
    {"id":"S04","scene":"SEA","sequence":5,"channel":"屏","status":"新增·P1可选","text":"试着张开手，等它自己过来。","trigger":"仅在 PALM/掌心位置稳定时启用；P0 可跳过","required":false},
    {"id":"R01","scene":"RETURN_WARD","sequence":1,"channel":"哥·便签草稿","status":"新增","text":"等她出院……","trigger":"返回病房，便签重新写下并停顿一秒","required":true},
    {"id":"W04","scene":"RETURN_WARD","sequence":2,"channel":"哥·主观闪字","status":"保留","text":"如果她不再需要我呢？","trigger":"看到水族馆票时短暂出现并被涂去","required":true},
    {"id":"R02","scene":"RETURN_WARD","sequence":3,"channel":"哥·改写后的便签","status":"新增","text":"我得帮她准备好。","trigger":"覆盖 W04","required":true},
    {"id":"R03","scene":"RETURN_WARD","sequence":4,"channel":"境·护士残缺字幕","status":"新增","text":"……小满……窗……","trigger":"护士在小满视野之外招呼；小满先反应再转头","required":true},
    {"id":"R04","scene":"RETURN_WARD","sequence":5,"channel":"妹·动作释义","status":"新增","text":"我留了两张票。","trigger":"小满主动把票推向玩家","required":true},
    {"id":"R05","scene":"RETURN_WARD","sequence":6,"channel":"妹·动作释义","status":"新增","text":"你也想去，对吧？","trigger":"等待玩家简单张掌确认；无答案也不羞辱","required":true},
    {"id":"M00","scene":"MIRROR","sequence":1,"channel":"屏","status":"新增","text":"看向镜子。","trigger":"窗户倒影形成镜面","required":true},
    {"id":"M02","scene":"MIRROR","sequence":2,"channel":"屏·技术说明","status":"新增","text":"仅同步面部动作，不判断情绪。可跳过。","trigger":"镜面准备；无面捕时使用预制动画","required":true},
    {"id":"M01","scene":"MIRROR","sequence":3,"channel":"哥·主观","status":"保留","text":"我……还能说什么？","trigger":"镜面捕捉后，保留 2–3 秒无字沉默","required":true},
    {"id":"F00","scene":"FINAL_DOOR","sequence":1,"channel":"无对白","status":"新增","text":"","trigger":"镜面隔层出现；旧手势仅有识别光圈但不推进","required":true},
    {"id":"F0A","scene":"FINAL_DOOR","sequence":2,"channel":"妹·无文字动作","status":"新增","text":"","trigger":"剧情提示熄灭，小满放下双手并看向哥哥；帮助/暂停/退出仍可见","required":true},
    {"id":"F0B","scene":"FINAL_DOOR","sequence":3,"channel":"屏·温和提示","status":"新增·长等待","text":"她好像有话要说。","trigger":"约 15 秒未达成静止后才出现；继续卡关再给帮助","required":false},
    {"id":"F01","scene":"FINAL_DOOR","sequence":4,"channel":"妹·完整字幕","status":"保留","text":"我已经能听见了。但我还想这样和你说话。","trigger":"小满先伸手、玻璃开始退去之后；保留 2 秒阅读时间","required":true},
    {"id":"F10","scene":"FINAL_DOOR","sequence":5,"channel":"哥·主观","status":"新增","text":"我怕你不再需要我。","trigger":"F01 后一条短句，哥哥倒影稍抬头","required":true},
    {"id":"F02","scene":"FINAL_DOOR","sequence":6,"channel":"妹·完整字幕","status":"保留","text":"我想和你一起去，不是要你一直照顾我。","trigger":"F10 后，小满保持伸手姿势等待回应","required":true},
    {"id":"F11","scene":"FINAL_DOOR","sequence":7,"channel":"妹·动作释义","status":"新增·可省略","text":"现在，换我等你。","trigger":"使用教程中已出现的“我在这里”式游戏动作；P0 可省略","required":false},
    {"id":"F12","scene":"FINAL_DOOR","sequence":8,"channel":"屏·行动","status":"新增","text":"回应她。","trigger":"玩家再次做已学 PALM；识别失败时提供帮助或系统辅助","required":true},
    {"id":"END00","scene":"AQUARIUM","sequence":1,"channel":"妹·完整字幕","status":"新增","text":"你看，鱼又回来了。","trigger":"深海素材取消暗蓝遮罩，鱼群自由游动","required":true},
    {"id":"END01","scene":"END","sequence":2,"channel":"哥·主观","status":"保留","text":"原来我也可以被等候。","trigger":"明亮水族馆结尾","required":true},
    {"id":"END02","scene":"END","sequence":3,"channel":"标题","status":"新增","text":"请勿喧哗","trigger":"显示重玩/退出；不强制调取摄像头","required":true}
  ]
